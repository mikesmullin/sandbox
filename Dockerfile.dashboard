FROM docker.io/oven/bun:1.2-alpine

RUN apk add --no-cache ca-certificates kubectl

WORKDIR /app
COPY package.json bunfig.toml ./
RUN bun install --production
COPY src ./src
COPY public ./public

ENV PORT=8080 \
    NAMESPACE=agent-desktop \
    DESKTOP_APP=desktop
EXPOSE 8080
USER bun
CMD ["bun", "src/server.coffee"]
