/target
# The musl cua-spacesd binary is built by desktop/build-spacesd.sh, not committed
# (it is ~60-125MB and arch-specific — rebuild it for the host you image on).
/desktop/dist/
# Per-install HMAC secret for the sandbox tokens — never commit.
/.cua-secret
# Per-install control-plane bearer token for the host MCP server — never commit.
/.sbox-lan-token
# Runtime state: the orchestration store is rebuilt from the container CLI.
/tmp/
